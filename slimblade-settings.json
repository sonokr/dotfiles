{
    "description": "SlimBlade Settings",
    "manipulators": [
        {
            "from": {
                "modifiers": { "optional": ["any"] },
                "pointing_button": "button1"
            },
            "to": [
                {
                    "set_variable": {
                        "name": "button1_layer",
                        "value": 1
                    }
                },
                { "pointing_button": "button1" }
            ],
            "to_after_key_up": [
                {
                    "set_variable": {
                        "name": "button1_layer",
                        "value": 0
                    }
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "button1_layer",
                    "type": "variable_unless",
                    "value": 1
                }
            ],
            "from": {
                "modifiers": { "optional": ["any"] },
                "simultaneous": [
                    { "pointing_button": "button3" },
                    { "pointing_button": "button4" }
                ],
                "simultaneous_options": {
                    "detect_key_down_uninterruptedly": true,
                    "key_down_order": "insensitive",
                    "key_up_order": "insensitive",
                    "key_up_when": "any"
                }
            },
            "parameters": { "basic.simultaneous_threshold_milliseconds": 500 },
            "to": [{ "key_code": "mission_control" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "button1_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "modifiers": { "optional": ["any"] },
                "pointing_button": "button3"
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["left_control"],
                    "repeat": true
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "button1_layer",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "modifiers": { "optional": ["any"] },
                "pointing_button": "button4"
            },
            "to": [
                {
                    "key_code": "right_arrow",
                    "modifiers": ["left_control"],
                    "repeat": true
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "button1_layer",
                    "type": "variable_unless",
                    "value": 1
                }
            ],
            "from": {
                "modifiers": { "optional": ["any"] },
                "pointing_button": "button3"
            },
            "to": [
                {
                    "key_code": "tab",
                    "modifiers": ["left_control", "left_shift"],
                    "repeat": false
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "button1_layer",
                    "type": "variable_unless",
                    "value": 1
                }
            ],
            "from": {
                "modifiers": { "optional": ["any"] },
                "pointing_button": "button4"
            },
            "to": [
                {
                    "key_code": "tab",
                    "modifiers": ["left_control"],
                    "repeat": false
                }
            ],
            "type": "basic"
        }
    ]
}
