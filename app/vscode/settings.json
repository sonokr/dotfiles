{
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": false,
  "window.title": " ",

  "workbench.colorTheme": "Iceberg",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": true,
  "workbench.sideBar.location": "right",
  "workbench.preferredHighContrastLightColorTheme": "Iceberg",
  "workbench.panel.showLabels": false,

  // color settings
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#161821",
    "titleBar.activeForeground": "#161821",
    "titleBar.inactiveBackground": "#161821",
    "titleBar.inactiveForeground": "#161821",
    "titleBar.border": "#161821",
    "tab.inactiveBackground": "#161821",
    "tab.border": "#161821",
    "tab.activeBorder": "#161821",
    "tab.inactiveModifiedBorder": "#161821",
    "editorGroupHeader.tabsBackground": "#161821",
    "editorGutter.background": "#161821",
    "editor.background": "#161821",
    "statusBar.background": "#161821",
    "statusBar.foreground": "#161821",
    "statusBar.border": "#161821",
    "sideBarTitle.foreground": "#6B7089",
    "sideBar.border": "#161821",
    "panel.border": "#161821",
  },

  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.profiles.osx": { "zsh": { "path": "/bin/zsh" }},
  "terminal.integrated.fontSize": 14,

  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "all",
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "on",
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.rulers": [],
  "editor.bracketPairColorization.enabled": true,
  "editor.accessibilitySupport": "off",
  "editor.renderLineHighlight": "all",
  "editor.renderLineHighlightOnlyWhenFocus": true,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "edditor.bracketPairColorization.enable": false,
  "editor.guides.highlightActiveBracketPair": false,
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.indentation": false,
  "editor.showFoldingControls": "never",
  "editor.glyphMargin": false,

  "color-highlight.markRuler": false,
  "breadcrumbs.enabled": false,

  "files.trimTrailingWhitespace": true,
  "files.autoSave": "afterDelay",

  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindings": [{ "before": ["j", "j"], "after": ["<Esc>"] }],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false
  },
  "security.workspace.trust.untrustedFiles": "open",
  "chat.commandCenter.enabled": false,
  "lazygit-vscode.lazygitPath": "/opt/homebrew/bin/lazygit",
  "extensions.ignoreRecommendations": true,
  "workbench.editor.enablePreview": false,
}
