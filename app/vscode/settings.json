{
  "window.commandCenter": false,

  "workbench.colorTheme": "Iceberg Light",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": true,
  "workbench.sideBar.location": "right",
  "workbench.preferredHighContrastLightColorTheme": "Iceberg Light",

  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.profiles.osx": { "zsh": { "path": "/bin/zsh" }},
  "terminal.integrated.fontSize": 14,

  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "all",
  "editor.cursorStyle": "line",
  "editor.lineNumbers": "on",
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "on",
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.rulers": [88, 119],
  "editor.bracketPairColorization.enabled": true,
  "editor.accessibilitySupport": "off",

  "files.trimTrailingWhitespace": true,
  "files.autoSave": "afterDelay",

  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindings": [{ "before": ["j", "j"], "after": ["<Esc>"] }],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false
  },
  "security.workspace.trust.untrustedFiles": "open",
  "vscode_custom_css.imports": [
    "file://${userHome}/.vscode/styles.css",
    "file:///Users/ryotakusunoki/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js"
  ],
  "chat.commandCenter.enabled": false,
  "lazygit-vscode.lazygitPath": "/opt/homebrew/bin/lazygit",
}
